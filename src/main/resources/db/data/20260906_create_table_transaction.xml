<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="3" author="Dominik">
        <createTable tableName="transactions">
            <column
                    name="id"
                    type="bigint"
                    autoIncrement="true">
                <constraints primaryKey="true"
                             nullable="false"/>
            </column>

            <column
                    name="short_name"
                    type="varchar(25)">
                <constraints nullable="false"/>
            </column>

            <column
                    name="description"
                    type="varchar">
                <constraints nullable="false"/>
            </column>

            <column
                    name="amount"
                    type="bigint">
                <constraints nullable="false"/>
            </column>

            <column
                    name="date"
                    type="date">
                <constraints nullable="false"/>
            </column>

            <column
                    name="transaction_type"
                    type="varchar(20)">
                <constraints nullable="false"
                checkConstraint="type IN('INCOME', 'EXPENSE', 'SAVINGS', 'BORROW', 'LEND', 'OTHER')"/>
                <!--
                checkConstraint doesn't work in current config. To be checked after moving to PostgreSQL
                -->
            </column>

            <column
                    name="category_id"
                    type="bigint">
                <constraints nullable="false"/>
            </column>

        </createTable>
    </changeSet>
</databaseChangeLog>